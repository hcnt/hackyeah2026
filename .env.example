ENV=prod
# Oracle key that signs payouts: the JSON array from a solana-keygen file, e.g. [12,34,...]. Never commit it.
ORACLE_KEYPAIR=bCq84tN7KsmSX89YF6rmL4ogLKMPV66kXmewiJHVRty
SOLANA_RPC_URL=https://api.devnet.solana.com
# Default RPC baked into the web apps at build time. It ends up in the public JS, so use a key restricted to the
# site's origins. Empty = the public devnet RPC.
VITE_SOLANA_RPC_URL=

# Edge router: the only thing published on the host (127.0.0.1:8080, where the host's
# cloudflared sends onsight.site and *.onsight.site). Routes by Host to app stacks on the shared "edge"
# Docker network, where each stack's caddy has the network alias "prod" or "pr-<N>".
{
	auto_https off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

:80 {
	@preview header_regexp pr Host ^pr-(\d+)\.onsight\.site$
	handle @preview {
		# Resolved per request, so new previews need no reload. No such stack -> 502.
		reverse_proxy pr-{re.pr.1}:80
	}

	# onsight.site opens the events app; its attendee links (/?event=<id>) still reach the attendee page.
	@site host onsight.site www.onsight.site
	handle @site {
		@dashboard {
			path /
			not query event=*
		}
		rewrite @dashboard /events.html
		reverse_proxy prod:80
	}

	# demo-event.onsight.site is the attendee page, which defaults to the demo event.
	@prod host demo-event.onsight.site localhost 127.0.0.1
	handle @prod {
		reverse_proxy prod:80
	}

	handle {
		respond "Not found" 404
	}
}
